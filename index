<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Live Fresh — Retail Shop Explorer</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
  :root {
    /* Live Fresh green palette */
    --accent:        #3C9A3D;   /* main green — buttons, bars, markers, key numbers */
    --accent-light:  #A3D65C;   /* lime — highlights, gradient ends, fills */
    --accent-lighter:#C7E89A;   /* pale lime */
    --dark:          #1B3829;   /* deep green — hero bg, headings, chips */
    --tint:          #EFF7E6;   /* light active row */
    --bg:            #F8FAF6;
    --ink:           #262626;
    --body:          #404040;
    --muted:         #8A8A8A;
    --card:          #FFFFFF;
    --border:        #E8E8E8;
    --pm:            #FFA630;   /* produce-market marker/circle fill */
    --pm-stroke:     #E94F37;   /* produce-market marker/circle stroke */
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    font-family: "Inter", "Segoe UI", -apple-system, "Helvetica Neue", Arial, sans-serif;
    background: var(--bg); color: var(--ink); font-size: 14px; line-height: 1.45;
  }
  body { padding: 14px 24px 24px; max-width: 1500px; margin: 0 auto; }

  .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-logo { height: 56px; width: auto; display: block; }
  .brand-title { font-size: 15px; color: var(--muted); font-weight: 400; }
  .brand-title b { color: var(--ink); font-weight: 700; }

  .coverage-group + .coverage-group { margin-top: 12px; }
  .coverage-title {
    font-size: 10.5px; font-weight: 700; color: var(--muted);
    letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 4px;
  }

  .hero {
    background: var(--dark); color: white; border-radius: 14px 14px 0 0; padding: 12px 22px;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .hero .stat { border-left: 2px solid rgba(163,214,92,0.25); padding-left: 12px; }
  .hero .stat:first-child { border-left: 0; padding-left: 0; }
  .hero .stat-big {
    font-size: 30px; font-weight: 800; color: var(--accent-light);
    line-height: 1.05; letter-spacing: -0.5px;
  }
  .hero .stat-label {
    font-size: 11px; font-weight: 700; color: #a9cf91;
    letter-spacing: 1.3px; text-transform: uppercase; margin-top: 2px;
  }
  .hero .stat-sub { font-size: 11px; color: #7aa061; margin-top: 1px; }

  /* ── Radius control bar ─────────────────────────────────────────────── */
  .radius-bar {
    background: var(--accent); color: #fff; border-radius: 0 0 14px 14px;
    padding: 12px 22px; display: grid;
    grid-template-columns: auto 1fr auto; align-items: center; gap: 18px;
    margin-bottom: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .radius-bar .r-label {
    font-size: 11px; font-weight: 800; letter-spacing: 1.4px;
    text-transform: uppercase; color: #eaf6d9;
  }
  .radius-bar .r-slider-wrap { display: flex; flex-direction: column; gap: 3px; }
  #radius-slider { width: 100%; margin: 0; cursor: pointer; height: 5px; accent-color: var(--accent-light); }
  .radius-bar .r-ticks {
    display: flex; justify-content: space-between;
    font-size: 9.5px; color: #d5ebbe; font-weight: 600;
  }
  .radius-bar .r-value {
    font-size: 26px; font-weight: 800; color: #fff; line-height: 1;
    font-variant-numeric: tabular-nums; min-width: 92px; text-align: right;
  }
  .radius-bar .r-value small { font-size: 13px; font-weight: 600; color: #eaf6d9; }

  .grid { display: grid; grid-template-columns: minmax(360px, 1fr) 1.4fr; gap: 20px; }

  .panel {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 18px 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .panel h2 {
    font-size: 13px; font-weight: 800; color: var(--dark);
    letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px;
    display: flex; align-items: center; gap: 8px;
  }
  .panel h2::before { content: ""; width: 6px; height: 22px; border-radius: 3px; background: var(--accent); }
  .panel h2.sub { margin-top: 20px; }

  .controls { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .controls input {
    border: 1px solid var(--border); border-radius: 8px;
    padding: 8px 12px; font-size: 13px; font-family: inherit;
    background: white; outline: none; flex: 1; min-width: 180px;
  }
  .controls input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(163,214,92,0.28); }
  .btn {
    border: none; border-radius: 8px; padding: 8px 14px;
    font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit;
    letter-spacing: 0.5px; transition: transform 0.05s;
  }
  .btn:active { transform: scale(0.97); }
  .btn-primary { background: var(--accent-light); color: var(--dark); }
  .btn-primary:hover { background: #b2de6e; }
  .btn-ghost { background: transparent; color: var(--body); border: 1px solid var(--border); }
  .btn-ghost:hover { background: var(--bg); }

  .mall-list {
    max-height: 620px; overflow-y: auto;
    border: 1px solid var(--border); border-radius: 8px;
  }
  .mall-list::-webkit-scrollbar { width: 8px; }
  .mall-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  .mall-item {
    display: grid; grid-template-columns: 20px 1fr auto; gap: 12px;
    padding: 10px 12px; border-bottom: 1px solid #f0f0f0; align-items: center;
    cursor: pointer; user-select: none; font-size: 12.5px;
  }
  .mall-item:hover { background: #f4f7f1; }
  .mall-item.active { background: var(--tint); }
  .mall-item input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent); }
  .mall-item .name { font-weight: 700; color: var(--ink); }
  .mall-item .addr { display: block; font-weight: 400; color: var(--muted); font-size: 11px; margin-top: 1px; }
  .mall-item .hh { color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; text-align: right; }
  .mall-item .hh b { color: var(--accent); font-weight: 700; }

  .subpanel { }
  .subpanel + .subpanel { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
  .subpanel-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 10px; gap: 10px;
  }
  .subpanel-title {
    font-size: 12px; font-weight: 800; color: var(--dark);
    letter-spacing: 2px; text-transform: uppercase;
    display: flex; align-items: center; gap: 8px;
  }
  .subpanel-title::before { content: ""; width: 5px; height: 18px; border-radius: 3px; background: var(--accent); }
  .subpanel-title.pm::before { background: var(--pm); }
  .subpanel-count { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; font-weight: 600; }
  .subpanel-count b { color: var(--accent); font-weight: 800; }
  .subpanel-count b.pm { color: var(--pm-stroke); }

  .subpanel .controls { margin-bottom: 10px; }
  .subpanel .controls select {
    border: 1px solid var(--border); border-radius: 8px;
    padding: 8px 12px; font-size: 12px; font-family: inherit;
    background: white; outline: none;
  }

  .pm-list {
    max-height: 260px; overflow-y: auto;
    border: 1px solid var(--border); border-radius: 8px;
  }
  .pm-list::-webkit-scrollbar { width: 8px; }
  .pm-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  .pm-item {
    display: grid; grid-template-columns: 20px 38px 1fr auto; gap: 10px;
    padding: 8px 12px; border-bottom: 1px solid #f0f0f0; align-items: center;
    cursor: pointer; user-select: none; font-size: 12.5px;
  }
  .pm-item:hover { background: #fdf5ed; }
  .pm-item.active { background: #fbeedd; }
  .pm-item input[type=checkbox] { width: 15px; height: 15px; cursor: pointer; accent-color: var(--pm); }
  .pm-item .state-chip {
    background: #b35218; color: white; font-size: 10px; font-weight: 800;
    padding: 2px 5px; border-radius: 4px; text-align: center; letter-spacing: 0.5px;
  }
  .pm-item .name { font-weight: 500; color: var(--ink); }
  .pm-item .hh { color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; text-align: right; }
  .pm-item .hh b { color: var(--pm-stroke); font-weight: 700; }

  #map { height: 460px; width: 100%; border-radius: 10px; border: 1px solid var(--border); background: #eef4e8; }
  .leaflet-container { font-family: inherit; }
  .leaflet-popup-content { font-family: inherit; font-size: 12.5px; line-height: 1.4; }
  .leaflet-popup-content b { color: var(--dark); }
  .map-legend {
    display: flex; gap: 16px; margin-top: 8px; margin-bottom: 12px;
    font-size: 11.5px; color: var(--muted); flex-wrap: wrap;
  }
  .map-legend .chip { display: inline-block; width: 10px; height: 10px; margin-right: 4px; border-radius: 50%; vertical-align: middle; }
  .map-legend .chip.marker { background: var(--accent); }
  .map-legend .chip.circle { background: rgba(163,214,92,0.4); border: 1px solid var(--accent); }
  .map-legend .chip.marker-pm { background: var(--pm); border: 2px solid var(--pm-stroke); box-sizing: content-box; }
  .map-legend .chip.circle-pm { background: rgba(255,166,48,0.25); border: 1.5px dashed var(--pm-stroke); box-sizing: content-box; }
  .map-toggles {
    display: flex; gap: 16px; margin-bottom: 10px; flex-wrap: wrap;
    font-size: 12.5px; color: var(--body);
  }
  .map-toggles label { cursor: pointer; user-select: none; display: flex; align-items: center; gap: 6px; }
  .map-toggles input { accent-color: var(--pm); width: 14px; height: 14px; }
  .map-empty {
    display: flex; align-items: center; justify-content: center;
    height: 100%; color: var(--muted); font-size: 13px; padding: 20px; text-align: center;
  }

  .coverage-bar-wrap { margin-top: 4px; margin-bottom: 4px; }
  .coverage-bar { height: 14px; background: #eef2ea; border-radius: 7px; overflow: hidden; border: 1px solid var(--border); }
  .coverage-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-light)); border-radius: 7px; width: 0%; transition: width 0.3s ease; }
  .coverage-label { display: flex; justify-content: space-between; margin-top: 4px; font-size: 11px; color: var(--muted); }

  .state-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .state-table th {
    text-align: left; padding: 6px 8px; font-size: 10px;
    color: var(--muted); text-transform: uppercase; letter-spacing: 1.5px;
    border-bottom: 1px solid var(--border); font-weight: 700;
  }
  .state-table td { padding: 5px 8px; border-bottom: 1px solid #f3f3f3; font-variant-numeric: tabular-nums; }
  .state-table tr.active { background: #f3f8eb; }
  .state-table td.state { font-weight: 700; color: var(--dark); font-size: 12px; }
  .state-table td.num { text-align: right; }
  .state-table td.bar { position: relative; width: 60px; }
  .state-bar-bg { height: 6px; background: #eef2ea; border-radius: 3px; overflow: hidden; }
  .state-bar-fill { height: 100%; background: var(--accent-light); }
  .state-wrap { max-height: 260px; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; }
  .state-wrap::-webkit-scrollbar { width: 8px; }
  .state-wrap::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .quick-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .quick-actions .btn { padding: 6px 12px; font-size: 11px; }

  .footer-note { margin-top: 16px; font-size: 11px; color: var(--muted); font-style: italic; text-align: center; }
  .empty { padding: 40px; text-align: center; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>

<div class="header">
  <div class="brand">
    <img class="brand-logo" src="data:image/png;base64," alt="Live Fresh" />
    <div class="brand-title" style="margin-left: 4px;">Retail <b>Shop Explorer</b></div>
  </div>
</div>

<div class="hero">
  <div class="stat">
    <div class="stat-big" id="stat-hh">0</div>
    <div class="stat-label">Households</div>
    <div class="stat-sub" id="stat-hh-sub">Deduplicated</div>
  </div>
  <div class="stat">
    <div class="stat-big" id="stat-coverage">0%</div>
    <div class="stat-label">of U.S. HH</div>
    <div class="stat-sub">Reach coverage</div>
  </div>
  <div class="stat">
    <div class="stat-big" id="stat-malls">0</div>
    <div class="stat-label">Shops Selected</div>
    <div class="stat-sub" id="stat-states-sub">0 states</div>
  </div>
  <div class="stat">
    <div class="stat-big" id="stat-pop">0</div>
    <div class="stat-label">Population</div>
    <div class="stat-sub" id="stat-pop-sub">Within 20 miles</div>
  </div>
  <div class="stat">
    <div class="stat-big" id="stat-income">$0</div>
    <div class="stat-label">Avg HH Income</div>
    <div class="stat-sub">Weighted, Census</div>
  </div>
</div>

<div class="radius-bar">
  <div class="r-label">Catchment<br>radius</div>
  <div class="r-slider-wrap">
    <input type="range" id="radius-slider" min="5" max="50" step="5" value="20">
    <div class="r-ticks">
      <span>5</span><span>10</span><span>15</span><span>20</span><span>25</span>
      <span>30</span><span>35</span><span>40</span><span>45</span><span>50</span>
    </div>
  </div>
  <div class="r-value"><span id="radius-value">20</span> <small>mi</small></div>
</div>

<div class="grid">
  <div class="panel">
    <h2>Total Opportunity</h2>

    <div class="quick-actions">
      <button class="btn btn-primary" onclick="selectAll()">All locations</button>
      <button class="btn btn-ghost" onclick="clearAll()">Clear all</button>
    </div>

    <div class="subpanel">
      <div class="subpanel-header">
        <div class="subpanel-title">Retail Shops</div>
        <div class="subpanel-count"><b id="mall-selected-count">0</b> / <span id="mall-total-count">0</span> selected</div>
      </div>
      <div class="controls">
        <input type="text" id="search" placeholder="Search location or address…">
      </div>
      <div class="mall-list" id="mall-list"></div>
    </div>

    <div class="subpanel">
      <div class="subpanel-header">
        <div class="subpanel-title pm">Produce Markets</div>
        <div class="subpanel-count"><b class="pm" id="pm-selected-count">0</b> / <span id="pm-total-count">0</span> selected</div>
      </div>
      <div class="controls">
        <input type="text" id="pm-search" placeholder="Search produce market…">
        <select id="pm-state-filter">
          <option value="">All states</option>
        </select>
      </div>
      <div class="pm-list" id="pm-list"></div>
    </div>
  </div>

  <div class="panel">
    <h2>Map View</h2>
    <div class="map-toggles">
      <label><input type="checkbox" checked id="toggle-pm"> Show unselected produce markets &nbsp;<span style="color:var(--muted);">(reference, fixed 20-mi zones — checked ones in the list always show)</span></label>
    </div>
    <div id="map"></div>
    <div class="map-legend">
      <span><span class="chip marker"></span>Selected shop</span>
      <span><span class="chip circle"></span>Shop <span id="legend-radius">20</span>-mi catchment</span>
      <span><span class="chip marker-pm"></span>Produce Market</span>
      <span><span class="chip circle-pm"></span>Produce-market 20-mi zone</span>
    </div>

    <div class="coverage-bar-wrap">
      <div class="coverage-group">
        <div class="coverage-title">Households coverage</div>
        <div class="coverage-bar"><div class="coverage-fill" id="coverage-fill"></div></div>
        <div class="coverage-label">
          <span>0 HH</span>
          <span id="coverage-text">0% of US</span>
          <span id="coverage-us-hh">US HH</span>
        </div>
      </div>
      <div class="coverage-group">
        <div class="coverage-title">Population coverage</div>
        <div class="coverage-bar"><div class="coverage-fill" id="coverage-fill-pop"></div></div>
        <div class="coverage-label">
          <span>0 Pop</span>
          <span id="coverage-text-pop">0% of US</span>
          <span id="coverage-us-pop">US Pop</span>
        </div>
      </div>
    </div>

    <h2 class="sub">State Breakdown</h2>
    <div class="state-wrap">
      <table class="state-table">
        <thead>
          <tr>
            <th>State</th>
            <th>Shops</th>
            <th style="text-align:right;">HH (dedup)</th>
            <th style="text-align:right;">% of US</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="state-tbody"></tbody>
      </table>
    </div>

    <div class="footer-note">
      Data: U.S. Census ACS 2024 (2020–2024), <span id="footer-radius">20</span>-mi radius, ZCTA-level deduplication.
    </div>
  </div>
