  };
  function choroFillColor(hh, maxHH) {
    if (!hh || hh <= 0 || !maxHH || maxHH <= 0) return "#F8FAF6";
    const frac = Math.max(0, Math.min(1, hh / maxHH));
    if (frac < 0.08) return "#F3F8E8";
    if (frac < 0.20) return "#E4F0CE";
    if (frac < 0.40) return "#CFE6A8";
    if (frac < 0.65) return "#B8DC85";
    if (frac < 0.85) return "#A3D65C";
    return              "#7DB83B";
  }
  function choroStyle(feature) {
    const abbr = STATE_NAME_TO_ABBR[feature.properties.name] || "";
    const hasSelection = (stateHH.__max || 0) > 0;
    let hh, max, fillOpacity;
    if (hasSelection) {
      hh = stateHH[abbr] || 0; max = stateHH.__max;
      if (hh > 0) { fillOpacity = 0.55; }
      else { hh = (STATE_BASELINE_HH[abbr] || 0) * 0.15; max = 13260000; fillOpacity = 0.16; }
    } else { hh = STATE_BASELINE_HH[abbr] || 0; max = 13260000; fillOpacity = 0.4; }
    return { fillColor: choroFillColor(hh, max), weight: 0.8, opacity: 1, color: "#c9d9b7", fillOpacity: fillOpacity };
  }
  async function loadChoropleth() {
    if (!map || statesGeoJson) return;
    try {
      const resp = await fetch("https://cdn.jsdelivr.net/gh/PublicaMundi/MappingAPI@master/data/geojson/us-states.json");
      statesGeoJson = await resp.json();
      choroLayer = L.geoJSON(statesGeoJson, {
        style: choroStyle,
        onEachFeature: (feature, layer) => {
          const abbr = STATE_NAME_TO_ABBR[feature.properties.name] || "";
          layer.on("mouseover", () => {
            const reachHH = stateHH[abbr] || 0, baselineHH = STATE_BASELINE_HH[abbr] || 0;
            layer.bindTooltip(
              "<b>" + feature.properties.name + "</b><br>" +
              (reachHH > 0 ? fmtM(reachHH) + " reachable HH <em>(selected)</em><br>" : "") +
              fmtM(baselineHH) + " total HH <em>(Census)</em>",
              { sticky: true, direction: "top" }).openTooltip();
          });
        },
      });
      choroLayer.addTo(map); choroLayer.bringToBack(); restyleChoropleth();
    } catch (err) { console.warn("Choropleth failed:", err); }
  }
  function restyleChoropleth() { if (choroLayer) choroLayer.setStyle(choroStyle); }

  // ── SHOP MARKERS (radius-aware) ──────────────────────────────────────────
  function mallPopupHtml(mall) {
    const s = mallStats(mall);
    return "<b>" + mall.n + "</b><br>" + mall.addr + "<br>" +
      fmtM(s.hh) + " HH within " + currentRadius + " mi<br>" +
      s.n + " ZCTAs · avg income " + fmt$(avgIncomeFor(mall));
  }
  function avgIncomeFor(mall) {
    let agg = 0, hh = 0;
    const idxs = mallZctas(mall);
    for (let i = 0; i < idxs.length; i++) { const zd = Z[idxs[i]]; if (zd && zd[2] > 0 && zd[0] > 0) { agg += zd[2]; hh += zd[0]; } }
    return hh > 0 ? Math.round(agg / hh) : 0;
  }
  function addMallToMap(mall) {
    if (!map) return;
    const radiusMeters = currentRadius * 1609.34;
    const circle = L.circle([mall.lat, mall.lon], {
      radius: radiusMeters, color: "#3C9A3D", weight: 1.5, opacity: 0.7,
      fillColor: "#A3D65C", fillOpacity: 0.18,
    });
    const marker = L.circleMarker([mall.lat, mall.lon], {
      radius: 7, color: "#1B3829", weight: 2, fillColor: "#3C9A3D", fillOpacity: 1,
    }).bindPopup(mallPopupHtml(mall));
    circle.addTo(map); marker.addTo(map);
    mallMapLayers.set(mall.id, { marker, circle });
  }
  function removeMallFromMap(id) {
    if (!map) return;
    const l = mallMapLayers.get(id); if (!l) return;
    map.removeLayer(l.marker); map.removeLayer(l.circle); mallMapLayers.delete(id);
  }
  function updateMapRadius() {
    if (!map) return;
    const radiusMeters = currentRadius * 1609.34;
    mallMapLayers.forEach((l, id) => { l.circle.setRadius(radiusMeters); l.marker.setPopupContent(mallPopupHtml(DATA.malls[id])); });
  }
  function fitMap() {
    if (!map) return;
    if (mallMapLayers.size === 0) { map.setView([33.66, -117.9], 9); return; }
    const bounds = L.latLngBounds([]);
    mallMapLayers.forEach(l => bounds.extend(l.circle.getBounds()));
    map.fitBounds(bounds, { padding: [30, 30], maxZoom: 11 });
  }

  // ── PRODUCE-MARKET OVERLAY (fixed 20-mi zones) ───────────────────────────
  // Purely visual context around the 3 retail shops — these do NOT feed the
  // households/population/income stats above, which stay anchored to the
  // selected retail shops only. Checking one in the list below marks it
  // "active" (bright, solid outline); the master toggle above the map only
  // controls whether the unselected *reference* markets are shown.
  const pmMapLayers = new Map();
  let pmVisibleOnMap = true;
  const PM_STAGE_STYLE = {
    1: { mR: 8, mOp: 1.0, cOp: 0.75, fOp: 0.14, label: "Stage 1" },
    2: { mR: 7, mOp: 0.9, cOp: 0.55, fOp: 0.10, label: "Stage 2" },
    3: { mR: 5, mOp: 0.7, cOp: 0.35, fOp: 0.06, label: "Future expansion" },
  };
  function renderPmOnMap(pm, isSelected) {
    if (!map) return;
    const existing = pmMapLayers.get(pm.id);
    if (existing) { map.removeLayer(existing.marker); map.removeLayer(existing.circle); pmMapLayers.delete(pm.id); }
    if (!pmVisibleOnMap && !isSelected) return;   // hide reference when toggled off; selected always shows
    const s = PM_STAGE_STYLE[pm.stage] || PM_STAGE_STYLE[3];
    const radiusMeters = 20 * 1609.34;   // produce-market zone is always 20 mi, independent of the shop radius slider
    const circle = L.circle([pm.lat, pm.lon], {
      radius: radiusMeters,
      color: "#E94F37",
      weight: isSelected ? 2.5 : 1.5,
      opacity: isSelected ? 0.95 : s.cOp,
      fillColor: "#FFA630",
      fillOpacity: isSelected ? 0.22 : s.fOp,
      dashArray: isSelected ? null : "6, 6",
    });
    const marker = L.circleMarker([pm.lat, pm.lon], {
      radius: isSelected ? (s.mR + 2) : s.mR,
      color: "#A02010",
      weight: isSelected ? 3 : 2,
      fillColor: "#FFA630",
      fillOpacity: isSelected ? 1 : s.mOp,
    }).bindPopup(
      "<b>" + pm.n + "</b><br>" + pm.st + " · ZIP " + pm.z + "<br>" +
      fmtM(pm.hh) + " HH within 20 mi<br>" +
      "Avg HH income: " + fmt$(pm.inc) + "<br>" +
      "<em>Produce market · " + s.label +
      (isSelected ? " · <b style=\"color:#3C9A3D\">✓ active</b>" : "") + "</em>"
    );
    circle.addTo(map); marker.addTo(map);
    pmMapLayers.set(pm.id, { marker, circle });
  }
  function refreshAllPmMarkers() {
    if (!map || !DATA.pms) return;
    DATA.pms.forEach(pm => renderPmOnMap(pm, selectedPMs.has(pm.id)));
  }
  function renderPmList() {
    if (!DATA.pms) { elPmList.innerHTML = '<div class="empty">Produce market data unavailable.</div>'; return; }
    const q = elPmSearch.value.trim().toLowerCase();
    const filterState = elPmStateFilter.value;
    elPmList.innerHTML = "";
    let shown = 0;
    DATA.pms.forEach(pm => {
      if (filterState && pm.st !== filterState) return;
      if (q && !pm.n.toLowerCase().includes(q)) return;
      shown++;
      const row = document.createElement("label");
      row.className = "pm-item" + (selectedPMs.has(pm.id) ? " active" : "");
      row.innerHTML =
        '<input type="checkbox" ' + (selectedPMs.has(pm.id) ? "checked" : "") + ' data-id="' + pm.id + '">' +
        '<span class="state-chip">' + pm.st + '</span>' +
        '<span class="name">' + pm.n + '</span>' +
        '<span class="hh"><b>' + fmtM(pm.hh) + '</b> HH · ' + fmtM(pm.pop) + ' pop</span>';
      elPmList.appendChild(row);
    });
    if (shown === 0) elPmList.innerHTML = '<div class="empty">No produce markets match filters.</div>';
    $("pm-selected-count").textContent = selectedPMs.size;
  }

  // ── LIST ─────────────────────────────────────────────────────────────────
  function renderMallList() {
    const q = elSearch.value.trim().toLowerCase();
    elList.innerHTML = "";
    let shown = 0;
    DATA.malls.forEach(m => {
      if (q && !(m.n.toLowerCase().includes(q) || (m.addr || "").toLowerCase().includes(q))) return;
      shown++;
      const s = mallStats(m);
      const row = document.createElement("label");
      row.className = "mall-item" + (selectedMalls.has(m.id) ? " active" : "");
      row.innerHTML =
        '<input type="checkbox" ' + (selectedMalls.has(m.id) ? "checked" : "") + ' data-id="' + m.id + '">' +
        '<span><span class="name">' + m.n + '</span><span class="addr">' + m.addr + '</span></span>' +
        '<span class="hh"><b>' + fmtM(s.hh) + '</b> HH<br>' + s.n + ' zips</span>';
      elList.appendChild(row);
    });
    if (shown === 0) elList.innerHTML = '<div class="empty">No locations match your search.</div>';
    $("mall-selected-count").textContent = selectedMalls.size;
  }

  // ── RECOMPUTE ──────────────────────────────────────────────────────────
  function recompute() {
    const zipUnion = new Set(); const statesSelected = new Set();
    selectedMalls.forEach(id => {
      const m = DATA.malls[id];
      const idxs = mallZctas(m);
      for (let i = 0; i < idxs.length; i++) zipUnion.add(idxs[i]);
      statesSelected.add(m.z.slice ? stateFromZip(m) : "CA");
    });

    let uHH = 0, uPop = 0, aggInc = 0, hhForInc = 0;
    stateHH = {}; let stateMax = 0;
    zipUnion.forEach(ci => {
      const zd = Z[ci]; if (!zd) return;
      uHH += zd[0]; uPop += zd[1];
      if (zd[2] > 0 && zd[0] > 0) { aggInc += zd[2]; hhForInc += zd[0]; }
      const st = DATA.zip_states[ci];
      if (st) { stateHH[st] = (stateHH[st] || 0) + zd[0]; if (stateHH[st] > stateMax) stateMax = stateHH[st]; }
    });
    stateHH.__max = stateMax;
    restyleChoropleth();

    const avgInc = hhForInc > 0 ? Math.round(aggInc / hhForInc) : 0;
    const covPct = US_HH > 0 ? (uHH / US_HH) * 100 : 0;
    const popPct = US_POP > 0 ? (uPop / US_POP) * 100 : 0;

    $("stat-hh").textContent         = fmtM(uHH);
    $("stat-hh-sub").textContent     = fmt(uHH) + " HH";
    $("stat-coverage").textContent   = covPct.toFixed(2) + "%";
    $("stat-malls").textContent      = fmt(selectedMalls.size);
    $("stat-states-sub").textContent = statesSelected.size + " state" + (statesSelected.size === 1 ? "" : "s") + " covered";
    $("stat-pop").textContent        = fmtM(uPop);
    $("stat-income").textContent     = selectedMalls.size > 0 ? fmt$(avgInc) : "$0";

    $("coverage-fill").style.width     = Math.min(100, covPct) + "%";
    $("coverage-text").textContent     = fmtM(uHH) + " HH · " + covPct.toFixed(2) + "% of US";
    $("coverage-fill-pop").style.width = Math.min(100, popPct) + "%";
    $("coverage-text-pop").textContent = fmtM(uPop) + " Pop · " + popPct.toFixed(2) + "% of US";

    // State breakdown — zips grouped under each shop's home state
    const stateZips = {}, stateMallCount = {};
    DATA.malls.forEach(m => {
      if (!selectedMalls.has(m.id)) return;
      const st = homeState(m);
      stateMallCount[st] = (stateMallCount[st] || 0) + 1;
      if (!stateZips[st]) stateZips[st] = new Set();
      const idxs = mallZctas(m);
      for (let i = 0; i < idxs.length; i++) stateZips[st].add(idxs[i]);
    });
    const stateRows = Object.keys(stateZips).map(st => {
      let hh = 0; stateZips[st].forEach(ci => { const zd = Z[ci]; if (zd) hh += zd[0]; });
      return { st, hh, malls: stateMallCount[st] || 0 };
    }).sort((a, b) => b.hh - a.hh);

    const tbody = $("state-tbody"); tbody.innerHTML = "";
    const maxHH = stateRows.length > 0 ? stateRows[0].hh : 1;
    stateRows.forEach(r => {
      const tr = document.createElement("tr"); tr.className = "active";
      const pct = (r.hh / US_HH) * 100;
      tr.innerHTML =
        '<td class="state">' + r.st + '</td>' +
        '<td class="num">' + r.malls + '</td>' +
        '<td class="num">' + fmtM(r.hh) + '</td>' +
        '<td class="num">' + pct.toFixed(2) + '%</td>' +
        '<td class="bar"><div class="state-bar-bg"><div class="state-bar-fill" style="width:' + (r.hh / maxHH * 100) + '%;"></div></div></td>';
      tbody.appendChild(tr);
    });
    if (stateRows.length === 0)
      tbody.innerHTML = '<tr><td colspan="5" class="empty" style="padding: 20px;">Select a shop to see the state breakdown.</td></tr>';

    fitMap();
    $("mall-selected-count").textContent = selectedMalls.size;
  }

  // Home state for a shop = the state of the ZCTA nearest the shop (ring 0), else its zip prefix guess.
  function homeState(m) {
    for (let k = 0; k < m.c.length; k++) {
      if (m.c[k].length) { const st = DATA.zip_states[m.c[k][0]]; if (st) return st; }
    }
    return "CA";
  }
  function stateFromZip(m) { return homeState(m); }

  // ── EVENTS ───────────────────────────────────────────────────────────────
  elList.addEventListener("change", e => {
    if (e.target.matches('input[type=checkbox]')) {
      const id = parseInt(e.target.dataset.id, 10);
      const mall = DATA.malls[id];
      if (e.target.checked) { selectedMalls.add(id); addMallToMap(mall); }
      else                  { selectedMalls.delete(id); removeMallFromMap(id); }
      e.target.closest(".mall-item").classList.toggle("active", e.target.checked);
      recompute();
    }
  });
  elSearch.addEventListener("input", renderMallList);

  elPmList.addEventListener("change", e => {
    if (e.target.matches('input[type=checkbox]')) {
      const id = parseInt(e.target.dataset.id, 10);
      if (e.target.checked) { selectedPMs.add(id); } else { selectedPMs.delete(id); }
      e.target.closest(".pm-item").classList.toggle("active", e.target.checked);
      $("pm-selected-count").textContent = selectedPMs.size;
      refreshAllPmMarkers();
    }
  });
  elPmSearch.addEventListener("input", renderPmList);
  elPmStateFilter.addEventListener("change", renderPmList);

  const elRadius = $("radius-slider");
  function applyRadius() {
    currentRadius = parseInt(elRadius.value, 10);
    radiusStep    = RADII.indexOf(currentRadius) + 1;
    if (radiusStep < 1) radiusStep = 1;
    $("radius-value").textContent  = currentRadius;
    $("legend-radius").textContent = currentRadius;
    $("footer-radius").textContent = currentRadius;
    $("stat-pop-sub").textContent  = "Within " + currentRadius + " miles";
    updateMapRadius(); renderMallList(); recompute();
  }
  elRadius.addEventListener("input", applyRadius);

  const elTogglePm = $("toggle-pm");
  if (elTogglePm) {
    elTogglePm.addEventListener("change", e => {
      pmVisibleOnMap = e.target.checked;
      refreshAllPmMarkers();
    });
  }

  // ── QUICK ACTIONS ──────────────────────────────────────────────────────
  function resetAllMapLayers() {
    mallMapLayers.forEach(l => { if (map) { map.removeLayer(l.marker); map.removeLayer(l.circle); } });
    mallMapLayers.clear();
  }
  window.clearAll = () => { resetAllMapLayers(); selectedMalls.clear(); renderMallList(); recompute(); };
  window.selectAll = () => {
    resetAllMapLayers(); selectedMalls.clear();
    DATA.malls.forEach(m => { selectedMalls.add(m.id); addMallToMap(m); });
    renderMallList(); recompute();
  };

  // ── INIT ───────────────────────────────────────────────────────────────
  initMap();
  loadChoropleth();
  refreshAllPmMarkers();
  renderPmList();
  applyRadius();
  window.selectAll();   // start with all shops selected
})();
</script>
</body>
</html>
